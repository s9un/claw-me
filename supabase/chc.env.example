# Drop Rate & Catch Config (chc.env)
# Gunakan file ini sebagai environment/secrets di Supabase Edge Functions

# Peluang berhasil mencapit (user login normal vs pity bonus)
CATCH_CHANCE_NORMAL=30
CATCH_CHANCE_PITY=90
PITY_THRESHOLD=10

# Peluang tier hadiah saat berhasil mencapit (total = 100%)
TIER_C_CHANCE=58.9
TIER_B_CHANCE=25
TIER_A_CHANCE=15
TIER_SS_CHANCE=1
TIER_SSR_CHANCE=0.1

# Token & Harga
DAILY_FREE_TOKENS=3
CLAWME_REDEEM_TOKENS=5
TOKEN_PRICE_IDR=1000

# Saweria Webhook Stream Key (dari dashboard Saweria -> Integration -> Webhook)
SAWERIA_STREAM_KEY=your-saweria-stream-key
SAWERIA_DONATION_URL=https://saweria.co/your-username
